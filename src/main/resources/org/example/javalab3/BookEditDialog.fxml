<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javalab3.controller.BookEditDialogController"
            prefWidth="600.0"
            prefHeight="600.0">

    <Label text="Информация о книге"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"
           layoutX="30.0"
           layoutY="20.0"/>

    <GridPane layoutX="30.0"
              layoutY="65.0"
              hgap="15.0"
              vgap="12.0">

        <Label text="Название:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="titleField"
                   prefWidth="350.0"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Переплёт:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="bindingField"
                   promptText="Твёрдый или мягкий"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Издательство:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="publisherField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Год издания:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="yearField"
                   promptText="Например: 2024"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <Label text="Жанр:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="genreField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

    </GridPane>

    <Label text="Информация об авторе"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"
           layoutX="30.0"
           layoutY="275.0"/>

    <GridPane layoutX="30.0"
              layoutY="315.0"
              hgap="15.0"
              vgap="12.0">

        <Label text="ФИО:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="authorNameField"
                   prefWidth="350.0"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Телефон:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="authorPhoneField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="E-mail:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="authorEmailField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Рейтинг:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="authorRatingField"
                   promptText="От 0 до 5"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

    </GridPane>

    <HBox spacing="10.0"
          layoutX="350.0"
          layoutY="535.0">

        <Button text="OK"
                defaultButton="true"
                onAction="#handleOk"/>

        <Button text="Отмена"
                cancelButton="true"
                onAction="#handleCancel"/>

    </HBox>

</AnchorPane>